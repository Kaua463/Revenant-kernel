+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Exact rodin stock contract; review-only until integration gates pass. */
+#ifndef _LINUX_XIAOMI_DMABUF_HUGE_H
+#define _LINUX_XIAOMI_DMABUF_HUGE_H
+#include <linux/mm.h>
+#include <linux/huge_mm.h>
