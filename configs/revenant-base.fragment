# Revenant Beta-v1.0 — baseline
# KernelSU-Next + SuSFS + heritage memory/I/O tuning

# KernelSU-Next
CONFIG_KSU=y

# SuSFS — feature set (SUS_MAP desabilitado: hunk fs/proc/task_mmu.c falha)
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
# CONFIG_KSU_SUSFS_SUS_MAP is not set

# I/O scheduler — Kyber + Deadline + BFQ (mesma stack do upstream rodin)
CONFIG_MQ_IOSCHED_KYBER=y
CONFIG_MQ_IOSCHED_DEADLINE=y
CONFIG_IOSCHED_BFQ=y
CONFIG_BFQ_GROUP_IOSCHED=y

# Memory: ZSWAP — v1.5 (K2/K5#1): compilado mas NAO default-on.
# Device tinha zswap default-ON em cima do zram = camada dupla (comprime lz4/zbud,
# no overflow descomprime e re-comprime no zram). Regressao vs stock MTK. Desligar
# default-on => swap = zram puro. Boot-safe (so remove a camada redundante).
CONFIG_ZSWAP=y
# CONFIG_ZSWAP_DEFAULT_ON is not set
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_LZ4=y

# Memory: ZRAM — v1.5 (K3/K4/K5#2): BUILT-IN pra deployar NOSSO zram c/ multi-comp.
# Device carregava zram.ko STOCK (/system_dlkm, vermagic 6.6.89, SEM multi-comp)
# porque a AnyKernel zip so flasha o Image (modules/ vazio). Logo o multi-comp
# era inerte e o def-comp zstd do inc1 NAO fez nada (init.mt6899.rc forca lz4 no .ko stock).
# (NOTA: nao usar tokens com prefixo de config em comentario aqui — o check_defconfig
#  do kleaf varre esses tokens em qualquer linha e quebra o build.)
# =y embute multi-comp no vmlinux; o modprobe do zram.ko stock vira no-op (class "zram-control"
# ja registrada -> EEXIST, init nao-fatal). NAO mexe no system_dlkm verity'd (erofs RO).
# *** VALIDAR NO FLASH-TEST: zram0 criado pelo built-in, vendor swapon ok, load do .ko
#     stock falha gracioso sem travar boot. E o unico lever deste ciclo que exige device. ***
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
# primario lz4 (init forca lz4 = paginas quentes baixa latencia); zstd entra como
# recomp_algorithm (tier de pagina fria) via runtime no modulo Rodin existente.
CONFIG_ZRAM_DEF_COMP_LZ4=y
# CONFIG_ZRAM_DEF_COMP_LZORLE is not set
CONFIG_ZRAM_MULTI_COMP=y
CONFIG_ZRAM_WRITEBACK=y
# idle tracking: necessario p/ "echo idle > /sys/block/zram0/idle" + recompress type=idle
CONFIG_ZRAM_TRACK_ENTRY_ACTIME=y

# Multi-gen LRU enabled at boot
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y

# Pressure Stall Information always-on
CONFIG_PSI=y
# CONFIG_PSI_DEFAULT_DISABLED is not set

# TCP BBR como congestion default (substitui cubic)
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
# CONFIG_DEFAULT_CUBIC is not set

# CRC32 hw accel (ja vem com CRYPTO_CRC32_ARCH em kernels novos)
CONFIG_CRYPTO_CRC32=y
CONFIG_CRYPTO_CRC32C=y

# Compression algos
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_LZO=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_CRYPTO_DEFLATE=y

# v1.1: force module load — bypass vermagic + CRC mismatch from rodin vendor modules
# rodin vendor_dlkm modules built against g03fb7c87b0b5 (6.6.89)
# Revenant is 6.6.127 — CRCs may differ. MODULE_FORCE_LOAD lets modprobe -f override.
CONFIG_MODULE_FORCE_LOAD=y
CONFIG_MODULE_FORCE_UNLOAD=y

# ============================================================
# v1.5 — SCOPE secao B (toggles aditivos KMI-safe)
# ============================================================
# CAKE: anti-bufferbloat qdisc (SCOPE: EronX NAO tem, diferencial nosso).
# Aditivo, generico GKI, nao toca ABI de vendor module. Boot-safe.
CONFIG_NET_SCH_CAKE=y
#
# /proc/rodin — interface de controle dos modos (driver builtin, source em rodin/).
# v0 = interface-only, NAO muta sistema no boot => nao pode bootloopar.
CONFIG_RODIN=y
#
# HELD (NAO adicionados — risco de bootloop / verificacao pendente):
#  - CONFIG_DEBUG_INFO off  -> mata BTF (DEBUG_INFO_BTF) -> bpfloader do Android
#                              falha no init = BRICK. NAO desligar.
#  - CONFIG_FTRACE off      -> remove simbolos que vendor modules importam +
#                              mexe em superficie ABI do GKI. Hold ate validar.
#  - CONFIG_PELT_UTIL_SHIFT  -> simbolo pode NAO existir no GKI android15-6.6
#                              (e patch out-of-tree MTK). Verificar no tree antes;
#                              setar inexistente = no-op silencioso, nao entrega nada.
#  - CONFIG_SCHED_DEBUG off -> baixo valor, hold.
